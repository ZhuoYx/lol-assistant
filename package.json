{
  "name": "lol-assistant",
  "private": true,
  "version": "0.1.0",
  "description": "英雄联盟助手工具",
  "scripts": {
    "dev:desktop": "pnpm --filter @lol-assistant/desktop dev",
    "build:desktop": "pnpm --filter @lol-assistant/desktop build",
    "build:shared": "pnpm --filter @lol-assistant/shared build",
    "lint": "eslint . --ext .ts,.vue",
    "lint:fix": "eslint . --ext .ts,.vue --fix",
    "format": "prettier --write \"packages/**/*.{ts,vue,json,css,scss}\""
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.28.0",
    "prettier": "^3.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "vue-demi"
    ]
  }
}

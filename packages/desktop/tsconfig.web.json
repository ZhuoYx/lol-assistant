{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./out/renderer",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.vue",
    "src/renderer/env.d.ts"
  ]
}

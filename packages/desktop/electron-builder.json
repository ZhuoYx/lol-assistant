{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.lol-assistant.app",
  "productName": "英雄联盟助手",
  "directories": {
    "buildResources": "resources",
    "output": "release"
  },
  "files": [
    "out/**/*",
    "resources/icons/poro-companion.ico"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "resources/icons/poro-companion.ico",
    "artifactName": "lol-assistant-${version}-${arch}-setup.${ext}",
    "requestedExecutionLevel": "requireAdministrator"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "shortcutName": "英雄联盟助手",
    "uninstallDisplayName": "英雄联盟助手"
  },
  "publish": {
    "provider": "github",
    "owner": "ZhuoYx",
    "repo": "lol-assistant",
    "releaseType": "draft"
  },
  "asar": true,
  "compression": "maximum"
}
